# Backend de embeddings
# "local"  -> all-MiniLM-L6-v2 (gratis, sin API key)
# "openai" -> text-embedding-3-small (requiere OPENAI_API_KEY)
EMBEDDING_BACKEND=local

# LLM (compatible con la API de OpenAI)
# Por defecto: Groq (capa gratuita).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_clave_de_groq
LLM_MODEL=llama-3.3-70b-versatile

# Alternativa: OpenAI
# EMBEDDING_BACKEND=openai
# OPENAI_API_KEY=sk_clave_de_openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk_clave_de_openai
# LLM_MODEL=gpt-4o-mini

# Rutas y parámetros de chunking
DOCS_DIR=./docs
VECTORSTORE_DIR=./vectorstore
# CHUNK_SIZE ajustado al tamaño promedio de una unidad de información de la
# documentación (~375 caracteres por error). Esto evita fusionar errores
# distintos en un mismo chunk, lo que degradaría la precisión de la búsqueda.
CHUNK_SIZE=300
CHUNK_OVERLAP=60


